# =============================================================================
# EnaV Platform - Root Environment Template (.env.example)
# Copy to appropriate service .env files or set in your deployment environment.
# DO NOT COMMIT REAL SECRETS OR CREDENTIALS.
# =============================================================================

# ===== Backend Service (FastAPI) =====
HOST=127.0.0.1
PORT=8000

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/enav_db

# Google Gemini API Key for Emergency Factual Summarization
GEMINI_API_KEY=your_gemini_api_key_here

# Open Charge Map API Key
OPENCHARGEMAP_API_KEY=your_openchargemap_api_key_here

# Routing Provider Configuration (osrm / mapbox / mock)
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=http://router.project-osrm.org/route/v1/driving
MAPBOX_ACCESS_TOKEN=your_mapbox_token_here

# Charging Station Provider Configuration (ocm / osm / mock)
CHARGER_PROVIDER=ocm
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Scoring Weights
TIME_WEIGHT=1.0
TRAFFIC_WEIGHT=10.0
BATTERY_RISK_WEIGHT=2.0

# ===== Frontend Application (Next.js) =====
NEXT_PUBLIC_API_URL=http://localhost:8000
